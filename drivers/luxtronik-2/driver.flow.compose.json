{
  "triggers": [
    {
      "id": "luxtronik_operationmode_changed",
      "title": {
        "en": "Operation Mode updated",
        "nl": "Warmtepompstatus bijgewerkt"
      },
      "tokens": [
        {
          "name": "luxtronik_operationmode",
          "type": "string",
          "title": {
            "en": "Operation mode",
            "nl": "Apparaatstatus"
          },
          "example": {
            "en": "Heating",
            "nl": "Verwamen"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "set_dhw_target_temperature",
      "title": {
        "en": "Set DHW target temperature",
        "nl": "Stel tapwater doeltemperatuur in"
      },
      "titleFormatted": {
        "en": "Set DHW target temperature to [[temperature]] °C",
        "nl": "Stel tapwater doeltemperatuur in op [[temperature]] °C"
      },
      "args": [
        {
          "type": "number",
          "name": "temperature",
          "title": {
            "en": "Temperature",
            "nl": "Temperatuur"
          },
          "min": 45,
          "max": 60,
          "step": 0.5
        }
      ]
    },
    {
      "id": "set_cooling_release_temperature",
      "title": {
        "en": "Set cooling release temperature",
        "nl": "Stel koelvrijgavetemperatuur in"
      },
      "titleFormatted": {
        "en": "Set cooling release temperature to [[temperature]] °C",
        "nl": "Stel koelvrijgavetemperatuur in op [[temperature]] °C"
      },
      "args": [
        {
          "type": "number",
          "name": "temperature",
          "title": {
            "en": "Cooling release temperature (not room target)",
            "nl": "Koelvrijgavetemperatuur (geen kamerdoel)"
          },
          "min": 10,
          "max": 35,
          "step": 0.5
        }
      ]
    },
    {
      "id": "restore_cooling_release_temperature",
      "title": {
        "en": "Restore original cooling release temperature",
        "nl": "Herstel oorspronkelijke koelvrijgavetemperatuur"
      },
      "titleFormatted": {
        "en": "Restore the original cooling release temperature",
        "nl": "Herstel de oorspronkelijke koelvrijgavetemperatuur"
      },
      "args": []
    },
    {
      "id": "set_heating_curve_correction",
      "title": {
        "en": "Set heating curve correction",
        "nl": "Stel stooklijncorrectie in"
      },
      "titleFormatted": {
        "en": "Set heating curve correction to [[correction]] °C",
        "nl": "Stel stooklijncorrectie in op [[correction]] °C"
      },
      "args": [
        {
          "type": "number",
          "name": "correction",
          "title": {
            "en": "Heating curve correction (global shift, not a room target)",
            "nl": "Stooklijncorrectie (globale verschuiving, geen kamerdoel)"
          },
          "min": -5,
          "max": 5,
          "step": 0.5
        }
      ]
    },
    {
      "id": "restore_heating_curve_correction",
      "title": {
        "en": "Restore original heating curve correction",
        "nl": "Herstel oorspronkelijke stooklijncorrectie"
      },
      "titleFormatted": {
        "en": "Restore the original heating curve correction",
        "nl": "Herstel de oorspronkelijke stooklijncorrectie"
      },
      "args": []
    }
  ],
  "conditions": [
    {
      "id": "operation_mode_is",
      "title": {
        "en": "Operation mode !{{is|is not}} [[mode]]",
        "nl": "Bedrijfsmodus !{{is|is niet}} [[mode]]"
      },
      "titleFormatted": {
        "en": "Operation mode !{{is|is not}} [[mode]]",
        "nl": "Bedrijfsmodus !{{is|is niet}} [[mode]]"
      },
      "args": [
        {
          "type": "dropdown",
          "name": "mode",
          "title": {
            "en": "Mode",
            "nl": "Modus"
          },
          "values": [
            { "id": "Heating", "label": { "en": "Heating", "nl": "Verwarmen" } },
            { "id": "Hot Water", "label": { "en": "Hot Water", "nl": "Warm water" } },
            { "id": "Swimming Pool/Solar", "label": { "en": "Swimming Pool/Solar", "nl": "Zwembad/Zonneboiler" } },
            { "id": "EVU", "label": { "en": "EVU", "nl": "EVU" } },
            { "id": "Defrost", "label": { "en": "Defrost", "nl": "Ontdooien" } },
            { "id": "No Request", "label": { "en": "No Request", "nl": "Geen vraag" } },
            { "id": "Heating External", "label": { "en": "Heating External", "nl": "Externe verwarming" } },
            { "id": "Cooling", "label": { "en": "Cooling", "nl": "Koelen" } }
          ]
        }
      ]
    }
  ]
}
